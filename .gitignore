/target_old_*/
**/target/
**/*.rs.bk
*.pdb
*.exe
*.dll
*.so
*.dylib
__pycache__/
*.pyc

# 测试/审计生成产物
/dist/
/dist-plugin-test/
*.plugin
*.plugin.sha256
/tests/release-smoke/latest/
/tests/release-smoke/*-pc-*/
/tests/release-smoke/*-apple-*/
/tests/release-smoke/*-linux-*
tests/fixtures/**/freshness-v1.json

# 不随公开源码发布的目录（历史开发/内部过程/第三方参考素材）
/sessions/
/.workbuddy/
/collab/
/spec/
/refs/design-ui/
/refs/ui-mockups/
/refs/screenshots/

